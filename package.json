{
  "name": "fetchworks-youtube-transcript",
  "version": "0.1.0",
  "description": "YouTube transcripts for Node.js and TypeScript \u2014 timestamped segments, plain text, SRT, VTT from videos, channels, playlists, and search. Thin client for the Fetchworks YouTube Transcript Scraper on Apify.",
  "keywords": [
    "youtube",
    "transcript",
    "captions",
    "subtitles",
    "srt",
    "vtt",
    "youtube-transcript",
    "apify"
  ],
  "license": "MIT",
  "author": "Fetchworks",
  "homepage": "https://apify.com/fetchworks/youtube-transcript-scraper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fetchworks/youtube-transcript.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}